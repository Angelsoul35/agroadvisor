# Copy to .env and adjust. All variables are optional; defaults are safe and the
# system runs fully offline (no API key required). With a provider key set, the
# LLM cascade phrases the advice; without one, a deterministic template does.

# Fraction of recent rainfall that reaches the root zone (0..1).
AA_EFFECTIVE_RAINFALL_FRACTION=0.8

# Pest/disease risk: number of favourable conditions (0..3) at which the label
# becomes MODERATE, then HIGH.
AA_RISK_MODERATE_AT=2
AA_RISK_HIGH_AT=3

# LLM provider cascade, tried in order. Each reads its own key from the env.
AA_LLM_SPEC=anthropic,openai,gemini,deepseek,ollama
AA_LLM_MAX_TOKENS=400

# Provider API keys (set the ones you use; leave unset to stay offline):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
